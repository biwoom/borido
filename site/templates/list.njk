{% extends "base.njk" %}
{% block content %}
<section>
  <p class="eyebrow">공개 자료</p>
  <h1>{{ page.title }}</h1>
  {% if page.description %}<p class="description">{{ page.description }}</p>{% endif %}
  {% if page.items.length %}
  <ul class="content-list">{% for item in page.items %}<li>{% if item.featured_image %}<figure class="prose"><img src="{{ item.featured_image.url }}" alt="{{ item.featured_image.alt }}"></figure>{% endif %}<a href="{{ item.url }}">{{ item.title }}</a>{% if item.meta %}<span class="count">{{ item.meta }}</span>{% endif %}{% if item.published_at %}<p><time datetime="{{ item.published_at }}">{{ item.published_label }}</time>{% if item.author %} · {{ item.author }}{% endif %}</p>{% endif %}{% if item.tags.length %}<ul class="tags">{% for tag in item.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}{% if item.description %}<p>{{ item.description }}</p>{% endif %}</li>{% endfor %}</ul>
  {% else %}<p class="empty">공개된 항목이 없습니다.</p>{% endif %}
</section>
{% endblock %}
